universe        = vanilla
executable      = $ENV(STARTDIR)/condor/BDT_executable.sh
output          = $ENV(STARTDIR)/condor/plotting_logs/bdt.$(ClusterId).$(ProcId).out
error           = $ENV(STARTDIR)/condor/plotting_logs/bdt.$(ClusterId).$(ProcId).err
log             = $ENV(STARTDIR)/condor/plotting_logs/bdt.$(ClusterId).log

# Fresh CMSSW env is set up inside the el8 image by the executable; do NOT import
# the submit-side environment (it points at /home/users CMSSW, not mounted on workers).
getenv = False
+DESIRED_Sites = "T2_US_UCSD"
+SingularityImage = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/cmssw/el8:x86_64"
requirements = (GLIDEIN_Site =!= "UCSDT2-C") && (HAS_SINGULARITY == True)


transfer_input_files = $ENV(STARTDIR)/package_BDT.tar.gz, $ENV(STARTDIR)/tuples_parking_nochi2
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

transfer_output_files  = working_point_$(BKGREJ)
transfer_output_remaps = "working_point_$(BKGREJ) = BDT/working_point_$(BKGREJ)"


request_memory = 16000
request_cpus   = 4
request_disk   = 20000000

JobBatchName = "ScoutingBDT"

arguments = --bkg-rej $(BKGREJ)

queue BKGREJ in (
0.9
0.99
0.999
0.9999
)
